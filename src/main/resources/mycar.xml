<?xml version="1.0" encoding="UTF-8" ?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">
        <bean name="engine" id="engine" class="com.spring.DependencyInjection.mycar.DieselEngine"/>
        <bean name="car" id="car" class="com.spring.DependencyInjection.mycar.Car">
            <constructor-arg name="car" ref="engine"/>
<!-- the above line says that the Car constructor need an object (or more specific we can say bean) -->
        </bean>

</beans>