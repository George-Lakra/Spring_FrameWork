<?xml version="1.0" encoding="UTF-8" ?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">
        <bean name ="employee" id="hR" class="com.spring.DependencyInjection.myoffice.HR"/>
        <bean name="employeeRepository" id="employeeRepository" class="com.spring.DependencyInjection.myoffice.EmployeeRepository">
            <property name="employee" ref="hR"/>
        <!-- the above line define that this is a setter injection -->
        </bean>
</beans>